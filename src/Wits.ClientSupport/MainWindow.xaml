<Window x:Class="Wits.ClientSupport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WITS Client Support" Height="570" Width="840"
        MinHeight="420" MinWidth="600" WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F1F5F9">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="WITS Client Support" FontSize="29" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,24"
                   Text="Internet connectivity diagnostics - v0.1.0"
                   FontSize="14" Foreground="#94A3B8"/>
        <Button x:Name="CheckButton" Grid.Row="2"
                Content="Check Internet Connection"
                Click="CheckButton_Click"
                Padding="22,13" HorizontalAlignment="Left"
                Background="#2563EB" Foreground="White"
                BorderThickness="0" FontSize="15" FontWeight="SemiBold"
                Cursor="Hand"/>
        <Border Grid.Row="3" Margin="0,22,0,14"
                CornerRadius="10" BorderBrush="#334155" BorderThickness="1"
                Background="#020617">
            <TextBox x:Name="LogConsole" Margin="14"
                     Background="Transparent" Foreground="#C8F7CF"
                     BorderThickness="0" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     AutomationProperties.Name="Connectivity log"/>
        </Border>
        <TextBlock Grid.Row="4" x:Name="StatusLabel"
                   Text="Ready. Click the button to start diagnostics."
                   Foreground="#94A3B8" FontSize="12"/>
    </Grid>
</Window>
